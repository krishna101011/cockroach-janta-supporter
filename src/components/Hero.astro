---
import { HERO, PLACEHOLDERS } from "../data/config";
import CTAButton from "./CTAButton.astro";
import Badge from "./Badge.astro";

const { UPI_ID, QR_IMAGE } = PLACEHOLDERS;
---

<section class="section-padding overflow-hidden bg-gradient-to-b from-saffron-soft/60 to-cream">
  <div class="content-container grid items-center gap-12 md:grid-cols-[1.1fr_0.9fr]">
    <div>
      <Badge>{HERO.trustBadge}</Badge>

      <h1 class="mt-5 text-[clamp(2.25rem,5vw,4rem)] font-semibold text-charcoal">{HERO.h1}</h1>
      <p class="mt-5 max-w-xl text-charcoal-soft">{HERO.subhead}</p>

      <div class="mt-8 flex flex-wrap gap-4">
        <CTAButton href="#telegram" variant="secondary" size="lg">{HERO.primaryCta}</CTAButton>
        <CTAButton href="#contribute" variant="primary" size="lg">{HERO.secondaryCta}</CTAButton>
      </div>
    </div>

    <div class="mx-auto w-full max-w-xs rounded-card bg-white p-5 shadow-soft">
      <p class="mb-3 text-center text-sm font-semibold text-charcoal">Scan to contribute</p>
      <div class="flex aspect-square items-center justify-center rounded-2xl border border-dashed border-charcoal/15 bg-cream p-4">
        {
          QR_IMAGE ? (
            <img src={QR_IMAGE} alt="QR code to contribute via UPI" class="h-full w-full object-contain" />
          ) : (
            <p class="text-center text-sm text-charcoal-soft">QR code coming soon</p>
          )
        }
      </div>
      <p class="mt-3 text-center text-xs text-charcoal-soft">{UPI_ID || "UPI ID coming soon"}</p>
      <a href="#contribute" class="mt-4 block text-center text-sm font-semibold text-saffron">
        See how it works →
      </a>
    </div>
  </div>
</section>

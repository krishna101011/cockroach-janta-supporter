---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const contributeHref = isHome ? "#contribute" : "/contribute";
const telegramHref = isHome ? "#telegram" : "/telegram";
---

<div
  class="fixed inset-x-0 bottom-0 z-50 flex items-center gap-3 border-t border-charcoal/10 bg-white/95 px-4 py-3 shadow-[0_-8px_24px_rgba(34,32,29,0.08)] backdrop-blur md:hidden"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
>
  <a
    href={telegramHref}
    class="flex-1 rounded-full border border-green/30 px-4 py-3 text-center text-sm font-semibold text-green"
  >
    Join Telegram
  </a>
  <a href={contributeHref} class="flex-1 rounded-full bg-saffron px-4 py-3 text-center text-sm font-semibold text-white">
    Contribute Now
  </a>
</div>

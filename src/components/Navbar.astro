---
import { NAV_LINKS, SITE } from "../data/config";
import CTAButton from "./CTAButton.astro";

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const contributeHref = isHome ? "#contribute" : "/contribute";
---

<header class="sticky top-0 z-50 border-b border-charcoal/5 bg-cream/90 backdrop-blur">
  <div class="content-container flex h-16 items-center justify-between md:h-20">
    <a href="/" class="flex items-center gap-2 text-lg font-semibold text-charcoal">
      <span class="font-display">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={isHome ? `#${link.id}` : link.standalone}
            class="text-sm font-medium text-charcoal-soft transition-colors hover:text-charcoal"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <CTAButton href={contributeHref} variant="primary">Contribute Now</CTAButton>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-full text-charcoal md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-charcoal/5 bg-cream px-5 pb-4 pt-2 md:hidden"
    aria-label="Mobile"
  >
    {
      NAV_LINKS.map((link) => (
        <a
          href={isHome ? `#${link.id}` : link.standalone}
          class="rounded-lg px-2 py-2.5 text-sm font-medium text-charcoal-soft hover:bg-white"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  as?: "h1" | "h2";
  class?: string;
}

const { eyebrow, title, subtitle, align = "center", as = "h2", class: className = "" } = Astro.props;
const Tag = as;
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---

<div class={`max-w-2xl ${alignClass} ${className}`}>
  {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-green">{eyebrow}</p>}
  <Tag class="text-[clamp(1.75rem,4vw,2.75rem)] font-semibold text-charcoal">{title}</Tag>
  {subtitle && <p class="mt-4 text-charcoal-soft">{subtitle}</p>}
</div>

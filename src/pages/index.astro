---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import InfoCard from "../components/InfoCard.astro";
import QRContributionCard from "../components/QRContributionCard.astro";
import StatCard from "../components/StatCard.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import ContactForm from "../components/ContactForm.astro";
import CTAButton from "../components/CTAButton.astro";
import {
  SITE,
  HERO,
  MISSION,
  HOW_WE_HELP,
  CONTRIBUTE,
  TELEGRAM,
  TRANSPARENCY,
  COMMUNITY_STATS,
  FAQ_ITEMS,
  CONTACT,
  PLACEHOLDERS,
} from "../data/config";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  description: SITE.defaultDescription,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout title={`${SITE.name} — ${HERO.h1}`} description={SITE.defaultDescription} isHome jsonLd={[organizationSchema, faqSchema]}>
  <Hero />

  <section id="mission" class="section-padding bg-cream">
    <div class="content-container">
      <SectionHeading title={MISSION.h2} />
      <p class="mx-auto mt-6 max-w-2xl text-center text-charcoal-soft">{MISSION.body}</p>
    </div>
  </section>

  <section id="how-we-help" class="section-padding bg-white">
    <div class="content-container">
      <SectionHeading title={HOW_WE_HELP.h2} />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {HOW_WE_HELP.cards.map((card) => <InfoCard icon={card.icon} title={card.title} description={card.description} />)}
      </div>
    </div>
  </section>

  <section id="contribute" class="section-padding bg-saffron-soft/40">
    <div class="content-container">
      <SectionHeading title={CONTRIBUTE.h2} subtitle={CONTRIBUTE.subhead} />
      <div class="mt-10">
        <QRContributionCard />
      </div>
    </div>
  </section>

  <section id="telegram" class="section-padding bg-green-soft/40">
    <div class="content-container text-center">
      <SectionHeading title={TELEGRAM.h2} subtitle={TELEGRAM.subhead} />
      <p class="mx-auto mt-4 max-w-xl text-sm text-charcoal-soft">{TELEGRAM.welcomeLine}</p>
      <div class="mt-8">
        {
          PLACEHOLDERS.TELEGRAM_LINK ? (
            <CTAButton href={PLACEHOLDERS.TELEGRAM_LINK} variant="secondary" size="lg">
              {TELEGRAM.button}
            </CTAButton>
          ) : (
            <span class="inline-flex items-center gap-2 rounded-full bg-green-soft px-6 py-3 text-sm font-medium text-green">
              Telegram link coming soon
            </span>
          )
        }
      </div>
    </div>
  </section>

  <section id="transparency" class="section-padding bg-white">
    <div class="content-container">
      <SectionHeading title={TRANSPARENCY.h2} subtitle={TRANSPARENCY.body} />
      <ul class="mx-auto mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
        {
          TRANSPARENCY.breakdown.map((item) => (
            <li class="rounded-card bg-cream px-5 py-4 text-center text-sm font-medium text-charcoal-soft shadow-soft">
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    COMMUNITY_STATS.length > 0 && (
      <section id="community" class="section-padding bg-cream">
        <div class="content-container">
          <SectionHeading title="What We've Done So Far" />
          <div class="mt-10 grid gap-6 sm:grid-cols-3">
            {COMMUNITY_STATS.map((stat) => (
              <StatCard label={stat.label} value={stat.value} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section id="faq" class="section-padding bg-white">
    <div class="content-container max-w-3xl">
      <SectionHeading title="Frequently Asked Questions" />
      <div class="mt-10">
        <FAQAccordion />
      </div>
    </div>
  </section>

  <section id="contact" class="section-padding bg-cream">
    <div class="content-container max-w-4xl">
      <SectionHeading title={CONTACT.h2} subtitle={CONTACT.subhead} />
      <div class="mt-10">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
